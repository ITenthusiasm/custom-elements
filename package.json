{
  "name": "@itenthusiasm/custom-elements-repo",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Isaiah Thomason",
  "workspaces": [
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/delete-generated-files.js",
    "build": "node scripts/build-library.js",
    "prelint": "vue-tsc --build --clean . src",
    "lint": "prettier --ignore-path .gitignore --check . && eslint --ignore-path .gitignore . && vue-tsc --build . src && svelte-check --no-tsconfig",
    "postlint": "vue-tsc --build --clean . src",
    "format": "prettier --ignore-path .gitignore --write .",
    "test": "npx playwright test",
    "test:ui": "npm run test -- --ui"
  },
  "devDependencies": {
    "@form-observer/core": "1.0.1",
    "@form-observer/preact": "1.0.1",
    "@form-observer/react": "1.0.1",
    "@form-observer/solid": "1.0.1",
    "@form-observer/svelte": "1.0.1",
    "@form-observer/vue": "1.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "0.14.5",
    "preact": "10.29.8",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.1",
    "solid-js": "1.9.15",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  }
}
